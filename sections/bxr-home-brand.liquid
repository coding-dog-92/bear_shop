<section class="bxr-home-brand" aria-labelledby="BxrBrand-{{ section.id }}">
  <div class="bxr-brand-visual">{% render 'rw-image', image: section.settings.image, fallback: 'bxr-brand-garage.webp', alt: section.settings.image_alt, sizes: '(min-width: 750px) 60vw, 100vw', width: 1600, height: 1000 %}</div>
  <div class="bxr-brand-narrative"><p class="rw-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="BxrBrand-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.body }}</div><a class="rw-text-link" href="{% render 'bxr-page-url', routes: routes, settings: settings, destination: 'about' %}">{{ section.settings.label | escape }}{% render 'rw-icon', name: 'arrow' %}</a></div>
</section>
{% schema %}
{
  "name": "BXR brand story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Silver track coupe in a sunlit pit garage"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BXR COMPETITION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For everything ahead."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Story",
      "default": "<p>The anticipation in the garage. The focus on the circuit. The details that bring it all together.</p><p>BXR Competition brings racing tires and braking components into one considered place, with clear information to help you take the next step with your build.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Link label",
      "default": "Get to know BXR"
    }
  ],
  "presets": [
    {
      "name": "BXR brand story"
    }
  ]
}
{% endschema %}
