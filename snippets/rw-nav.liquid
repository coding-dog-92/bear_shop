{% if menu != blank %}
  {% for link in menu.links %}
    {% if link.links != blank %}
      <details class="rw-nav-dropdown"><summary>{{ link.title | escape }}{% render 'rw-icon', name: 'caret' %}</summary><div>{% for child in link.links %}<a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>{% for grandchild in child.links %}<a class="rw-nav-subitem" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</div></details>
    {% else %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
  {% endfor %}
{% else %}
  <a href="{% render 'bxr-category-url', category: 'tires', collection: tires_collection, settings: settings %}">Tires</a>
  <a href="{% render 'bxr-category-url', category: 'brakes', collection: brakes_collection, settings: settings %}">Brakes</a>
  <a href="{{ routes.all_products_collection_url }}">All parts</a>
{% endif %}
