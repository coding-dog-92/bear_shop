<bxr-masthead><header class="rw-header bxr-paddock-header">
  <nav class="rw-desktop-nav" aria-label="Main navigation">{% render 'rw-nav', menu: section.settings.menu, routes: routes, tires_collection: section.settings.tires_collection, brakes_collection: section.settings.brakes_collection %}</nav>
  <details class="rw-mobile-nav"><summary class="rw-icon-button" aria-label="Open navigation">{% render 'rw-icon', name: 'hamburger' %}</summary><nav aria-label="Mobile navigation">{% render 'rw-nav', menu: section.settings.menu, routes: routes, tires_collection: section.settings.tires_collection, brakes_collection: section.settings.brakes_collection %}<a href="{% render 'bxr-page-url', routes: routes, settings: settings, destination: 'about' %}">About BXR</a><a href="{% render 'bxr-page-url', routes: routes, settings: settings, destination: 'support' %}">Contact us</a>{% if section.settings.show_account and shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Sign in / My account</a>{% endif %}</nav></details>
  <a class="rw-brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand | escape }} home">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 480 | image_tag: widths: '180, 240, 360, 480', sizes: '220px', alt: section.settings.brand }}{% else %}{{ section.settings.brand | escape }}{% endif %}</a>
  <div class="bxr-header-actions">
    <button class="rw-icon-button" type="button" data-bxr-open="BxrSearch-{{ section.id }}" aria-haspopup="dialog" aria-controls="BxrSearch-{{ section.id }}" aria-label="Search products">{% render 'rw-icon', name: 'search' %}</button>
    {% if section.settings.show_account and shop.customer_accounts_enabled %}<a class="rw-account rw-icon-button" href="{{ routes.account_url }}" aria-label="Account" title="Sign in / My account">{% render 'rw-icon', name: 'account' %}</a>{% endif %}
    <a class="rw-cart rw-icon-button" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }} ({{ cart.item_count }})">{% render 'rw-icon', name: 'cart-empty' %}{% if cart.item_count > 0 %}<span class="rw-cart-count">{{ cart.item_count }}</span>{% endif %}</a>
  </div>
</header></bxr-masthead>
<bxr-dialog><dialog class="bxr-drawer bxr-search-drawer" id="BxrSearch-{{ section.id }}" aria-labelledby="BxrSearchTitle-{{ section.id }}"><div class="bxr-drawer-heading"><h2 id="BxrSearchTitle-{{ section.id }}">Find your next part.</h2><button class="rw-icon-button" type="button" data-bxr-close aria-label="Close search">{% render 'rw-icon', name: 'close' %}</button></div><form action="{{ routes.search_url }}" method="get" role="search" class="bxr-search-form"><label for="BxrQuery-{{ section.id }}">Search products</label><div><input id="BxrQuery-{{ section.id }}" type="search" name="q" placeholder="Part name, size or keyword" required autofocus><button class="rw-icon-button" type="submit" aria-label="Submit search">{% render 'rw-icon', name: 'arrow' %}</button></div><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"></form><p class="rw-eyebrow">BROWSE BY CATEGORY</p><nav class="bxr-search-categories" aria-label="Search categories"><a href="{% render 'bxr-category-url', category: 'tires', settings: settings %}">Racing tires{% render 'rw-icon', name: 'arrow' %}</a><a href="{% render 'bxr-category-url', category: 'brakes', settings: settings %}">Braking components{% render 'rw-icon', name: 'arrow' %}</a></nav></dialog></bxr-dialog>
<noscript><form action="{{ routes.search_url }}" role="search" class="bxr-noscript-search"><label>Search products <input type="search" name="q" required></label><input type="hidden" name="type" value="product"><button type="submit">Search</button></form></noscript>
{% schema %}
{
  "name": "BXR header",
  "tag": "div",
  "class": "rw-header-section",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand name",
      "default": "BXR Competition"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "collection",
      "id": "tires_collection",
      "label": "Tires collection (fallback menu)"
    },
    {
      "type": "collection",
      "id": "brakes_collection",
      "label": "Brakes collection (fallback menu)"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show customer account link",
      "default": true,
      "info": "Enable customer accounts in Shopify Settings > Customer accounts."
    }
  ]
}
{% endschema %}
