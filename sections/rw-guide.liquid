<section class="rw-guide" id="rw-guides" aria-labelledby="RWGuide-{{ section.id }}">
  <div class="rw-guide-banner">
    {% render 'rw-image', image: section.settings.image, fallback: 'rw-guide.webp', alt: 'Close-up of racing tire rubber', loading: 'lazy', sizes: '100vw', width: 2007, height: 783 %}
    <div class="rw-guide-copy"><p class="rw-eyebrow">TECHNICAL GUIDES</p><h2 id="RWGuide-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p>
      {% if section.settings.link != blank %}<a class="rw-text-link" href="{{ section.settings.link }}">Explore guides{% render 'rw-icon', name: 'arrow' %}</a>{% else %}<a class="rw-text-link" href="#RWGuideArticles-{{ section.id }}" data-guide-open>Explore guides{% render 'rw-icon', name: 'arrow' %}</a>{% endif %}
    </div>
  </div>
  {% if section.settings.link != blank and section.blocks.size > 0 %}
    <div class="bxr-guide-links rw-gutter">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><p class="rw-eyebrow">GUIDE 0{{ forloop.index }}</p><h3>{{ block.settings.title | escape }}</h3><div>{{ block.settings.body }}</div><a class="rw-text-link" href="{{ block.settings.link | default: section.settings.link }}">Read guide{% render 'rw-icon', name: 'arrow' %}</a></article>{% endfor %}</div>
  {% endif %}
  {% if section.settings.link == blank %}
    <details class="rw-guide-articles rw-gutter" id="RWGuideArticles-{{ section.id }}">
      <summary>Setup essentials{% render 'rw-icon', name: 'plus' %}</summary>
      <div class="rw-guide-article-grid">
        {% for block in section.blocks %}<article {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><div>{{ block.settings.body }}</div></article>{% endfor %}
      </div>
    </details>
  {% endif %}
</section>

{% schema %}
{
  "name": "BXR guides",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know your setup."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Straightforward guides to help you choose the right tires and braking components for your track days."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Blog or guides page (optional)"
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Setup note",
      "settings": [
        {"type":"url","id":"link","label":"Guide destination (optional)"},
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BXR guides"
    }
  ]
}
{% endschema %}
