<section class="rw-featured rw-gutter" aria-labelledby="RWFeatured-{{ section.id }}">
  <div class="rw-section-heading"><h2 id="RWFeatured-{{ section.id }}">{{ section.settings.heading | escape }}</h2><a class="rw-text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">Explore all parts{% render 'rw-icon', name: 'arrow' %}</a></div>
  <div class="rw-products">
    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'rw-product-card', product: product, show_price: section.settings.show_price %}
      {% endfor %}
    {% elsif section.settings.show_editorial %}
      {% assign titles = 'Track tire,Brake caliper,Brake rotor' | split: ',' %}
      {% assign assets = 'rw-product-tire.webp,rw-product-caliper.webp,rw-product-rotor.webp' | split: ',' %}
      {% for title in titles %}
        <article class="rw-product-card">
          <a class="rw-product-image" href="{% render 'bxr-page-url', routes: routes, settings: settings, destination: 'guides' %}#{% if forloop.first %}tires{% else %}brakes{% endif %}">{% render 'rw-image', fallback: assets[forloop.index0], alt: title, loading: 'lazy', sizes: '(min-width: 750px) 30vw, 50vw', width: 1000, height: 800 %}</a>
          <h3>{{ title }}</h3><p class="rw-concept-label">Category preview · illustrative image</p><a class="rw-text-link" href="{% render 'bxr-page-url', routes: routes, settings: settings, destination: 'guides' %}#{% if forloop.first %}tires{% else %}brakes{% endif %}">Explore the guide{% render 'rw-icon', name: 'arrow' %}</a>
        </article>
      {% endfor %}
    {% else %}
      <p>New parts are on the way. Explore the collection to see what is available.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "BXR featured parts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Parts"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show live product prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_editorial",
      "label": "Show concept photography before selecting a collection",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Concept cards have no price or Add to cart action. Assign a collection to replace them with your real products."
    }
  ],
  "presets": [
    {
      "name": "BXR featured parts"
    }
  ]
}
{% endschema %}
