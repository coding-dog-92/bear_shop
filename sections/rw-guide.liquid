<section class="rw-guide bxr-paddock-guide" id="rw-guides" aria-labelledby="RWGuide-{{ section.id }}"><div class="bxr-guide-photo">{% render 'rw-image', image: section.settings.image, fallback: 'bxr-paddock-guide.webp', alt: 'Racing wheel and air tool in a pit lane', loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', width: 1600, height: 1000 %}</div><div class="rw-guide-copy"><p class="rw-eyebrow">SETUP GUIDES</p><h2 id="RWGuide-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="rw-text-link" href="{% if section.settings.link != blank %}{{ section.settings.link }}{% else %}{% render 'bxr-page-url', routes: routes, settings: settings, destination: 'guides' %}{% endif %}">Explore guides{% render 'rw-icon', name: 'arrow' %}</a></div></section>
{% schema %}
{
  "name": "BXR guides",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A closer look at your setup."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Straightforward guides to help you choose the right tires and braking components for your track days."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Blog or guides page (optional)"
    }
  ],
  "presets": [
    {
      "name": "BXR guides"
    }
  ]
}
{% endschema %}
