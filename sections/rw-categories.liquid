<section class="rw-categories" aria-label="Shop by category">
  {% for block in section.blocks %}
    {% assign destination = block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url %}
    {% assign fallback = 'rw-tires.webp' %}{% if forloop.index == 2 %}{% assign fallback = 'rw-brakes.webp' %}{% endif %}
    <a class="rw-category" href="{{ destination }}" {{ block.shopify_attributes }}>
      {% render 'rw-image', image: block.settings.image, fallback: fallback, alt: block.settings.subtitle, loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', width: 1200, height: 1000 %}
      <div class="rw-category-copy"><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.subtitle | escape }}</p><span class="rw-text-link">{{ block.settings.label | escape }}{% render 'rw-icon', name: 'arrow' %}</span></div>
    </a>
  {% endfor %}
</section>

{% schema %}
{
  "name": "BXR categories",
  "max_blocks": 2,
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Headline",
          "default": "Grip starts here."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Category name",
          "default": "Racing tires"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Explore tires"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom destination (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BXR categories",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category",
          "settings": {
            "heading": "Make every braking point count.",
            "subtitle": "Braking systems",
            "label": "View brake systems"
          }
        }
      ]
    }
  ]
}
{% endschema %}
