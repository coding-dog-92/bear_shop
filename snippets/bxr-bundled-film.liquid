{% comment %}Only the active viewport video is played and downloaded by BxrCarousel.{% endcomment %}
{% assign film_layouts = 'desktop,mobile' | split: ',' %}
{% for film_layout in film_layouts %}
  {% liquid
    assign film_asset = 'bxr-redline-film'
    if film_layout == 'mobile'
      assign film_asset = film_asset | append: '-mobile'
    endif
    assign film_filename = film_asset | append: '.mp4'
    assign film_poster = film_asset | append: '.webp' | asset_url
  %}
  <div class="bxr-hero-film" aria-hidden="true" data-video-layout="{{ film_layout }}">
    <video muted loop playsinline preload="none" tabindex="-1" poster="{{ film_poster }}">
      <source src="{{ film_filename | asset_url }}" type="video/mp4">
    </video>
  </div>
{% endfor %}
